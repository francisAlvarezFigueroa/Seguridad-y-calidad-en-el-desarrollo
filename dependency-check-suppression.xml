<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://github.io"
              xmlns:xsi="http://w3.org"
              xsi:schemaLocation="https://github.io https://github.io">

    <!-- 1. Mitigación global de falsos positivos para todo el ecosistema Spring 2026 -->
    <suppress>
        <notes><![CDATA[Falsos positivos de la suite de Spring mitigados por actualización manual y entorno controlado]]></notes>
        <gav regex="true">^org\.springframework.*$</gav>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- 2. Mitigación global de alertas residuales para el servidor embebido Tomcat -->
    <suppress>
        <notes><![CDATA[Se descartan alertas de Tomcat embebido por uso en entorno académico aislado]]></notes>
        <gav regex="true">^org\.apache\.tomcat.*$</gav>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

</suppressions>