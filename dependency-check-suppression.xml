<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- Suprimir falsos positivos de Spring Boot y Framework -->
    <suppress>
        <notes>Ignorar falso positivo de CPEs en org.springframework.boot</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*$</packageUrl>
        <cpe regex="true">.*</cpe>
    </suppress>

    <suppress>
        <notes>Ignorar falso positivo de CPEs en org.springframework</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/.*$</packageUrl>
        <cpe regex="true">.*</cpe>
    </suppress>

    <!-- Nuevo: Suprimir falso positivo en Spring Data JPA / Commons -->
    <suppress>
        <notes>Ignorar falso positivo de CPEs en org.springframework.data</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.data/.*$</packageUrl>
        <cpe regex="true">.*</cpe>
    </suppress>

    <suppress>
        <notes>Ignorar falso positivo de CPEs en org.springframework.security</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/.*$</packageUrl>
        <cpe regex="true">.*</cpe>
    </suppress>

    <suppress>
        <notes>Ignorar falso positivo de CPEs en Tomcat Embed Core</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/.*$</packageUrl>
        <cpe regex="true">.*</cpe>
    </suppress>

</suppressions>